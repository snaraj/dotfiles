# macOS metadata
.DS_Store

# work related items
zsh/pac-variables.zsh

# zsh runtime metadata
zsh/.zcompdump*
zsh/.zsh_history
zsh/.zsh_sessions
zsh/plugins/*

# git config holds signing key info, keep local
git/*

# gh CLI oauth token lives here
gh/hosts.yml

# secrets — never commit
vault/
secrets/
credentials/
keys/
tokens/

# files with sensitive words anywhere in the name
*secret*
*secrets*
*token*
*password*
*passwd*
*credential*
*credentials*
*apikey*
*api_key*
*api-key*
*private*

# environment files (often hold secrets)
.env
.env.*

# SSH keys and config
ssh/
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
id_dsa
id_dsa.*

# GPG / PGP keys
gnupg/
*.asc
*.pgp
*.gpg

# machine-local caches
raycast/
pip/*

# generated by the theme script
kitty/current-theme.conf
