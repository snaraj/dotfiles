# macOS metadata
.DS_Store

# work related items
zsh/pac-variables.zsh

# zsh runtime metadata
zsh/.zcompdump*
zsh/.zsh_history
zsh/.zsh_sessions
# the whole directory, not just its contents: each plugin is its own clone,
# so `zsh/plugins/*` still left the embedded repo re-addable as a gitlink
zsh/plugins/
zsh/completions/
zsh/.starship-init.zsh

# machine-local credential/tool state — never in the public repo
.claude/
agent-reviews/
gh/
naranjo-c2pa/
naranjo-usage-export/

# secrets — never commit
vault/
secrets/
credentials/
keys/
tokens/

# files with sensitive words anywhere in the name
*secret*
*secrets*
*token*
*password*
*passwd*
*credential*
*credentials*
*apikey*
*api_key*
*api-key*
*private*

# environment files (often hold secrets)
.env
.env.*

# SSH keys and config
ssh/
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
id_dsa
id_dsa.*

# GPG / PGP keys
gnupg/
*.asc
*.pgp
*.gpg

# machine-local caches
raycast/
pip/*

# generated by the theme CLI
kitty/current-theme.conf

# downloaded wallpapers — content, not configuration, and not ours to publish
wallpapers/
